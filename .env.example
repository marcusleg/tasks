# Copy this file to .env and adjust. Every setting is optional unless noted.

# The address people use to open the app. Required for OIDC and for secure cookies behind HTTPS.
PUBLIC_URL=http://localhost:3000
# Port on the host machine (docker compose only).
HOST_PORT=3000
# Name shown on the sign-in page and in the header.
APP_NAME=Tasks

# ---- Built-in accounts (email/username + password) ----
# Turn password sign-in off to use only OIDC.
AUTH_PASSWORD_ENABLED=true
# The first account can always be created. Set to true to let anyone create more accounts.
ALLOW_SIGNUP=false

# ---- OIDC single sign-on (Authentik, Keycloak, Authelia, Pocket ID, Zitadel, Google, Entra ID …) ----
# Leave OIDC_ISSUER empty to turn it off. Redirect URI to register at your provider:
#   <PUBLIC_URL>/auth/oidc/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
# Leave empty for a public client (PKCE only).
OIDC_CLIENT_SECRET=
# Text on the button: "Sign in with …"
OIDC_PROVIDER_NAME=Single sign-on
OIDC_SCOPES=openid profile email
# Create an account automatically the first time someone signs in through OIDC.
OIDC_ALLOW_SIGNUP=true
# Attach an OIDC sign-in to an existing account with the same verified email.
OIDC_LINK_EXISTING_BY_EMAIL=true
# Only allow members of these groups (comma separated). Empty = everyone your provider lets through.
OIDC_ALLOWED_GROUPS=
OIDC_GROUPS_CLAIM=groups
# With AUTH_PASSWORD_ENABLED=false: skip the sign-in page and go straight to the provider.
OIDC_AUTO_REDIRECT=false
# Also sign out of the provider when signing out of the app.
OIDC_LOGOUT_AT_PROVIDER=false

# ---- Advanced ----
# Set to true when running behind a reverse proxy (nginx, Caddy, Traefik) so rate limiting sees real client IPs.
TRUST_PROXY=false
# Days a sign-in lasts without use.
SESSION_DAYS=30
# Override the footer links on the sign-in page.
HELP_URL=
PRIVACY_URL=
TERMS_URL=
