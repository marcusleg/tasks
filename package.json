{
	"name": "tasks",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"engines": {
		"node": ">=26"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build",
		"prepare": "svelte-kit sync || echo ''",
		"check": "npm run i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "npm run i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"i18n:compile": "paraglide-js compile --project ./project.inlang --silent",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"screenshots": "playwright test --config playwright.screenshots.config.ts",
		"oidc:mock": "node e2e/oidc-mock.ts",
		"db:generate": "drizzle-kit generate",
		"db:studio": "drizzle-kit studio"
	},
	"dependencies": {
		"@fontsource/inter": "^5.3.0",
		"@fontsource/jetbrains-mono": "^5.3.0",
		"better-sqlite3": "^13.0.3",
		"drizzle-orm": "^0.45.4",
		"fractional-indexing": "^4.0.0",
		"openid-client": "^6.8.9",
		"temporal-polyfill": "^1.0.8"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^3.2.1",
		"@inlang/plugin-message-format": "^4.6.0",
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^26.6.6",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"ical.js": "^2.2.1",
		"oauth2-mock-server": "^9.3.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"rrule-temporal": "^2.2.8",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.7",
		"vitest": "^5.1.0"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"allowScripts": {
		"esbuild": true,
		"better-sqlite3": true
	}
}
